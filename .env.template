# Copy to .env only if one does not already exist. Never overwrite your existing key.
# Preserve the original ENCRYPTION_KEY to decrypt existing mailbox credentials.
# ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional before first setup; otherwise a password is generated locally.
# ADMIN_PASSWORD=at-least-16-random-characters
ENABLE_LIVE_EMAIL=0
DASHBOARD_URL=https://your-public-dashboard.example
# Optional separate working directory (absolute path recommended)
# LEADGEN_DATA_DIR=D:/leadgen/data-working
# Optional mailbox verifier adapter. MX alone never means verified.
# VERIFIER_API_URL=https://your-verifier.example/verify
# VERIFIER_API_KEY=your-private-provider-key
# Add mailboxes through the authenticated Accounts page.
