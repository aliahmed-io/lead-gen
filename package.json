{
  "name": "lead-scraper",
  "version": "1.0.0",
  "description": "Google Maps lead scraper for furniture and home decor stores \u00e2\u20ac\u201d extracts business details, emails, and platform info to Excel.",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/dashboard.cjs start",
    "dev": "node scripts/dashboard.cjs dev",
    "worker": "node scripts/run-node.cjs start.js",
    "setup": "node scripts/run-node.cjs scripts/setup.cjs",
    "scrape": "node scripts/run-node.cjs runtime/scrape-cli.js",
    "test": "node scripts/run-node.cjs --test tests/core.test.cjs tests/local-access.test.cjs",
    "lint": "node scripts/run-node.cjs node_modules/eslint/bin/eslint.js runtime scripts tests --ext .js,.cjs",
    "build": "node scripts/run-node.cjs node_modules/typescript/bin/tsc && node scripts/run-node.cjs scripts/check-source.cjs",
    "build:dashboard": "node scripts/dashboard.cjs build",
    "backup": "node scripts/run-node.cjs scripts/backup.cjs",
    "monitor": "node scripts/run-node.cjs runtime/monitor-service.js",
    "research:owners": "node scripts/run-node.cjs scripts/research-owners.cjs",
    "test:browser": "node scripts/run-node.cjs scripts/browser-check.cjs"
  },
  "keywords": [
    "lead-generation",
    "google-maps",
    "scraper",
    "furniture",
    "home-decor",
    "email-finder"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "date-holidays": "^3.30.2",
    "dotenv": "^17.4.2",
    "imapflow": "^1.3.7",
    "mailparser": "^3.9.9",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.2.1",
    "p-limit": "^2.3.0",
    "playwright": "^1.52.0",
    "proper-lockfile": "^4.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
