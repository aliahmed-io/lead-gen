{
  "name": "lead-scraper",
  "version": "1.0.0",
  "description": "Google Maps lead scraper for furniture and home decor stores — extracts business details, emails, and platform info to Excel.",
  "main": "index.js",
  "scripts": {
    "start": "node start.js",
    "dev": "concurrently \"npm run dev --prefix dashboard\" \"node start.js\"",
    "scrape": "node index.js",
    "lint": "eslint *.js e2e_tests",
    "test": "node e2e_tests/runner.js",
    "build": "tsc"
  },
  "keywords": [
    "lead-generation",
    "google-maps",
    "scraper",
    "furniture",
    "home-decor",
    "email-finder"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "date-holidays": "^3.30.2",
    "dotenv": "^17.4.2",
    "imapflow": "^1.3.7",
    "mailparser": "^3.9.9",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "p-limit": "^2.3.0",
    "playwright": "^1.52.0",
    "proper-lockfile": "^4.1.2",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
